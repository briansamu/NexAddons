{
  "schemaVersion": 1,
  "id": "nexaddons",
  "version": "${version}",
  "name": "NexAddons",
  "description": "A Skyblock Mod by SunexMC",
  "authors": [
    "NexAddons contributors"
  ],
  "contact": {
    "homepage": "https://github.com/briansamu/NexAddons",
    "sources": "https://github.com/briansamu/NexAddons",
    "issues": "https://github.com/briansamu/NexAddons/issues"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/nexaddons/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.nexaddons.NexAddons"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-language-kotlin": ">=${fabric_language_kotlin}",
    "fabric-api": ">=${fabric_api}",
    "minecraft": "${minecraft}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Source": "https://github.com/briansamu/NexAddons",
        "Issues": "https://github.com/briansamu/NexAddons/issues"
      }
    }
  }
}
